# The build needs the devDependencies — vite and its plugins — and the app is
# built on the same machine that runs it. Some hosts set production=true (or
# omit=dev) in the environment, which skips them and fails the build with
# "sh: vite: not found"; a project setting beats an environment one, so this
# keeps the build working wherever it is deployed.
#
# It does not silence npm's "use --omit=dev instead" warning: that comes from
# the host setting the deprecated option, not from anything here.
#
# Nothing is needed at run time — server/index.js imports only node: builtins
# and the app's own files — so this costs the running app nothing.
include=dev
